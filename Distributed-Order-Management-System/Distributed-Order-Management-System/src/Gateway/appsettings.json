{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.AspNetCore": "Information"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "OrderService": {
        "ClusterId": "OrderServiceCluster",
        "Match": {
          "Path": "/api/orders{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/orders{**catch-all} -> /api/orders{**catch-all}"
          }
        ]
      },
      "InventoryService": {
        "ClusterId": "InventoryServiceCluster",
        "Match": {
          "Path": "/api/inventory{**catch-all}"
        }
      },
      "PaymentService": {
        "ClusterId": "PaymentServiceCluster",
        "Match": {
          "Path": "/api/payments{**catch-all}"
        }
      },
      "NotificationService": {
        "ClusterId": "NotificationServiceCluster",
        "Match": {
          "Path": "/api/notifications{**catch-all}"
        }
      },
      "SagaOrchestrator": {
        "ClusterId": "SagaOrchestratorCluster",
        "Match": {
          "Path": "/api/sagas{**catch-all}"
        }
      },
      "Health": {
        "ClusterId": "HealthCluster",
        "Match": {
          "Path": "/health{**catch-all}"
        }
      }
    },
    "Clusters": {
      "OrderServiceCluster": {
        "Destinations": {
          "OrderService": {
            "Address": "http://localhost:5001"
          }
        },
        "HttpClient": {
          "Timeout": 30000
        }
      },
      "InventoryServiceCluster": {
        "Destinations": {
          "InventoryService": {
            "Address": "http://localhost:5002"
          }
        },
        "HttpClient": {
          "Timeout": 30000
        }
      },
      "PaymentServiceCluster": {
        "Destinations": {
          "PaymentService": {
            "Address": "http://localhost:5003"
          }
        },
        "HttpClient": {
          "Timeout": 30000
        }
      },
      "NotificationServiceCluster": {
        "Destinations": {
          "NotificationService": {
            "Address": "http://localhost:5004"
          }
        },
        "HttpClient": {
          "Timeout": 30000
        }
      },
      "SagaOrchestratorCluster": {
        "Destinations": {
          "SagaOrchestrator": {
            "Address": "http://localhost:5005"
          }
        },
        "HttpClient": {
          "Timeout": 30000
        }
      },
      "HealthCluster": {
        "Destinations": {
          "Gateway": {
            "Address": "http://localhost:5000"
          }
        }
      }
    }
  }
}
